{
  "name": "gestor-referencias",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-examples.mjs && vite",
    "build": "node scripts/build-examples.mjs && vite build",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && node tests/web.e2e.mjs && node tests/document.e2e.mjs",
    "test:live": "tsx tests/live.check.ts",
    "typecheck": "tsc --noEmit",
    "index": "tsx src/node/cli-index.ts",
    "verify": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "highlight.js": "11.11.1",
    "katex": "0.16.45",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "ajv": "8.20.0",
    "fake-indexeddb": "6.2.8",
    "pdfjs-dist": "6.5.438",
    "playwright": "1.56.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "6.4.6"
  }
}
